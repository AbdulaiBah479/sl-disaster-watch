# Postgres connection string — free tier works fine (Neon: https://neon.tech,
# Supabase: https://supabase.com). Required; there is no SQLite fallback.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Web Push (browser alert notifications). Generate a pair with:
#   npx web-push generate-vapid-keys
# NEXT_PUBLIC_VAPID_PUBLIC_KEY is exposed to the browser by design (it's the
# public half); VAPID_PRIVATE_KEY must stay server-only.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT="mailto:you@example.com"

# Minimum minutes between ingestion runs, regardless of what triggers one
# (scheduled cron, the dashboard's manual refresh button). Guards the free
# external APIs from being hammered if triggers overlap. Default: 10.
INGEST_MIN_INTERVAL_MINUTES=10

# Optional — enable every source (app runs fine without them, see README)
FIRMS_MAP_KEY=
RELIEFWEB_APPNAME=
