# Postgres connection string — free tier works fine (Neon: https://neon.tech,
# Supabase: https://supabase.com). Required; there is no SQLite fallback.
# uselibpqcompat=true silences a pg-connection-string v8 deprecation warning
# about sslmode=require's semantics changing in v9 — harmless either way, but
# this opts into the future (libpq-compatible) behavior now.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require&uselibpqcompat=true"

# Web Push (browser alert notifications). Generate a pair with:
#   npx web-push generate-vapid-keys
# NEXT_PUBLIC_VAPID_PUBLIC_KEY is exposed to the browser by design (it's the
# public half); VAPID_PRIVATE_KEY must stay server-only.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT="mailto:you@example.com"

# Minimum minutes between ingestion runs, regardless of what triggers one
# (scheduled cron, the in-process scheduler, the dashboard's manual refresh
# button). Guards the free external APIs from being hammered if triggers
# overlap. Default: 10.
INGEST_MIN_INTERVAL_MINUTES=10

# How often the in-process scheduler (instrumentation.ts) attempts a refresh
# on a persistently-running server (next start / next dev — NOT Netlify,
# whose serverless functions don't stay alive for setInterval; Netlify relies
# on .github/workflows/ingest-cron.yml instead). Default: 15.
INGEST_AUTO_INTERVAL_MINUTES=15

# Optional — enable every source (app runs fine without them, see README)
FIRMS_MAP_KEY=
RELIEFWEB_APPNAME=
